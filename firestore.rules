rules_version = '2';

// Regras de segurança do Mensal 100 Compromisso.
// Cole este arquivo inteiro em: Console do Firebase (projeto mensal-100compromisso)
// › Firestore Database › Regras › Publicar.
//
// Quem pode o quê:
// - Qualquer pessoa: ver mensalidades, presença, avulsos, caixa e uniforme (sem login).
// - Administradores: e-mails na coleção "admins" (um documento por e-mail, em minúsculas).
//   Só se cadastram pelo Console do Firebase.
// - Organizadores de um grupo: e-mails em grupos/{grupo}/organizadores. Alteram só aquele grupo.
// - Integrantes: enviam comprovante de Pix (login anônimo). Só o organizador vê.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function emailAtual() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(emailAtual()));
    }

    match /admins/{email} {
      allow read: if logado() && emailAtual() == email;
      allow write: if false;
    }

    match /grupos/{gid} {
      function isOrg() {
        return isAdmin()
          || (logado() && exists(/databases/$(database)/documents/grupos/$(gid)/organizadores/$(emailAtual())));
      }
      allow read: if true;
      allow write: if isAdmin();

      match /organizadores/{email} {
        allow read: if isAdmin() || (logado() && emailAtual() == email);
        allow write: if isAdmin();
      }
      match /integrantes/{id} { allow read: if true; allow write: if isOrg(); }
      match /pagamentos/{id} { allow read: if true; allow write: if isOrg(); }
      match /despesas/{id} { allow read: if true; allow write: if isOrg(); }
      match /avulsos/{id} { allow read: if true; allow write: if isOrg(); }
      match /jogos/{id} { allow read: if true; allow write: if isOrg(); }
      match /uniforme/{id} { allow read: if true; allow write: if isOrg(); }
      match /config/{id} { allow read: if true; allow write: if isOrg(); }

      // Comprovantes de Pix: qualquer visitante (login anônimo) envia; só o organizador vê, dá baixa ou apaga.
      match /comprovantes/{id} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['membro', 'nome', 'valor', 'itens', 'img', 'em', 'status', 'uid'])
          && request.resource.data.status == 'novo'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.img is string && request.resource.data.img.size() < 900000
          && request.resource.data.membro is string && request.resource.data.membro.size() < 80
          && request.resource.data.nome is string && request.resource.data.nome.size() < 80
          && request.resource.data.valor is number && request.resource.data.valor < 100000
          && request.resource.data.itens is list && request.resource.data.itens.size() < 40
          && request.resource.data.em is string && request.resource.data.em.size() < 30;
        allow read, update, delete: if isOrg();
      }
    }
  }
}
